# ============================================
# EXAMPLE: Wine-GE (wine-ge-custom)
# ============================================
# After extracting Wine-GE into runner/,
# the path is usually the release folder name.
# Example: runner/wine-ge-8-25  →  where bin/wine lives
#
# If you extracted directly into runner/ so that
#   runner/bin/wine  exists, just set:
#     path = runner
#     binary = wine
#
# ============================================

[Game]
name = GAME_NAME_HERE
exe = Game.exe
version = 1.0

[Runner]
type = bundled
path = runner/wine-ge-8-25
binary = wine

[Display]
resolution = auto
windowed = no
fix_resolution = no

[Dependencies]
verbs = vcrun2022

[Performance]
esync = yes
fsync = no
gamemode = auto
