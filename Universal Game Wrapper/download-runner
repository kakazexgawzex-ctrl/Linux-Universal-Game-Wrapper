#!/bin/bash

DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$DIR" || exit 1

CONFIG="$DIR/config.ini"

GUI=""
msg()    { printf '%s\n' "$@"; }
msg_err(){ printf 'Error: %s\n' "$*" >&2; }
info()   { msg "$@"; }
warn()   { msg "Warning: $*"; }
yesno()  { local a; read -r -p "$1 (y/N): " a; [ "$a" = "y" ] || [ "$a" = "Y" ]; }
choose() {
    printf '%s\n' "$1"
    printf '  1) Wine-GE (wine-ge-custom)\n'
    printf '  2) Proton-GE (proton-ge-custom)\n'
    local r; read -r -p "Select 1-2: " r
    case "$r" in
        1) echo "Wine-GE (wine-ge-custom)" ;;
        2) echo "Proton-GE (proton-ge-custom)" ;;
        *) echo "" ;;
    esac
}
dirsel() { local p="$1" d="$2" r; read -r -p "$p [$d]: " r; echo "${r:-$d}"; }

if command -v zenity &>/dev/null; then
    GUI="zenity"
    info()    { zenity --info --text="$1" --width=400 --no-wrap 2>/dev/null; }
    msg_err() { zenity --error --text="$1" --width=400 --no-wrap 2>/dev/null; }
    warn()    { zenity --warning --text="$1" --width=400 --no-wrap 2>/dev/null; }
    yesno()   { zenity --question --text="$1" --width=400 --no-wrap 2>/dev/null; }
    choose()  { zenity --list --radiolist --column="" --column="Option" \
                --title="$1" --text="$1" --height=200 --width=500 \
                FALSE "Wine-GE (wine-ge-custom)" \
                FALSE "Proton-GE (proton-ge-custom)" 2>/dev/null; }
    dirsel()  { local d; d="$(zenity --file-selection --directory \
                --title="$1" --filename="$2/" 2>/dev/null)"; [ -n "$d" ] && echo "$d" || echo "$2"; }
elif command -v kdialog &>/dev/null; then
    GUI="kdialog"
    info()    { kdialog --msgbox "$1" --title "Runner Downloader" 2>/dev/null; }
    msg_err() { kdialog --error "$1" --title "Runner Downloader" 2>/dev/null; }
    warn()    { kdialog --sorry "$1" --title "Runner Downloader" 2>/dev/null; }
    yesno()   { kdialog --yesno "$1" --title "Runner Downloader" 2>/dev/null; }
    choose()  { kdialog --combobox "$1" "Wine-GE (wine-ge-custom)" "Proton-GE (proton-ge-custom)" \
                --title "Runner Downloader" 2>/dev/null; }
    dirsel()  { kdialog --getexistingdirectory "$2" --title "$1" 2>/dev/null; }
    [ -z "$(dirsel test "$DIR")" ] && dirsel() { echo "$2"; }
elif command -v whiptail &>/dev/null; then
    GUI="whiptail"
    info()    { whiptail --msgbox "$1" 10 60 3>&1 1>&2 2>&3; }
    msg_err() { whiptail --msgbox "Error: $1" 10 60 --title "Error" 3>&1 1>&2 2>&3; }
    warn()    { whiptail --msgbox "$1" 10 60 --title "Warning" 3>&1 1>&2 2>&3; }
    yesno()   { whiptail --yesno "$1" 10 60 3>&1 1>&2 2>&3; }
    choose()  { whiptail --menu "$1" 12 60 2 \
                "Wine-GE" "wine-ge-custom" \
                "Proton-GE" "proton-ge-custom" 3>&1 1>&2 2>&3; }
    dirsel()  { whiptail --inputbox "$1" 10 60 "$2" 3>&1 1>&2 2>&3; }
elif command -v dialog &>/dev/null; then
    GUI="dialog"
    info()    { dialog --msgbox "$1" 10 60 3>&1 1>&2 2>&3; }
    msg_err() { dialog --msgbox "Error: $1" 10 60 --title "Error" 3>&1 1>&2 2>&3; }
    warn()    { dialog --msgbox "$1" 10 60 3>&1 1>&2 2>&3; }
    yesno()   { dialog --yesno "$1" 10 60 3>&1 1>&2 2>&3; }
    choose()  { dialog --menu "$1" 12 60 2 \
                "Wine-GE" "wine-ge-custom" \
                "Proton-GE" "proton-ge-custom" 3>&1 1>&2 2>&3; }
    dirsel()  { dialog --inputbox "$1" 10 60 "$2" 3>&1 1>&2 2>&3; }
else
    echo "No GUI tool found (zenity/kdialog/whiptail/dialog). Using terminal."
    echo "Tip: install zenity for graphical dialogs."
fi

missing=""
command -v curl &>/dev/null || missing="$missing curl"
command -v tar  &>/dev/null || missing="$missing tar"
if [ -n "$missing" ]; then
    msg_err "Missing tools:$missing. Please install them first."
    exit 1
fi

RUNNER_CHOICE="$(choose "Select runner to download:" "")"
[ -z "$RUNNER_CHOICE" ] && { info "Cancelled."; exit 0; }

case "$RUNNER_CHOICE" in
    *Wine-GE*|*wine-ge*)   REPO="wine-ge-custom"; TYPE="wine" ;;
    *Proton-GE*|*proton*)   REPO="proton-ge-custom"; TYPE="proton" ;;
    *) msg_err "Invalid choice."; exit 1 ;;
esac

DEST="$DIR/runner"
mkdir -p "$DEST"

info "Fetching latest $REPO release info from GitHub..."
API_URL="https://api.github.com/repos/GloriousEggroll/$REPO/releases/latest"
JSON="$(curl -sS -H "User-Agent: UGW-Downloader" "$API_URL" 2>/dev/null)"

if [ -z "$JSON" ] || echo "$JSON" | grep -q '"message": "Not Found"'; then
    msg_err "Failed to fetch release info. Check your internet connection."
    exit 1
fi

TAG="$(echo "$JSON" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"tag_name"[[:space:]]*:[[:space:]]*"//;s/"$//')"
ASSET_URL="$(echo "$JSON" | grep -o '"browser_download_url"[[:space:]]*:[[:space:]]*"[^"]*\.tar\.\(gz\|xz\|zst\)"' | head -1 | sed 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"//;s/"$//')"

if [ -z "$TAG" ] || [ -z "$ASSET_URL" ]; then
    msg_err "Could not parse release info from GitHub."
    exit 1
fi

FILENAME="${ASSET_URL##*/}"
OUTPUT="/tmp/$FILENAME"

if [ "$GUI" = "zenity" ]; then
    (
        curl -L -H "User-Agent: UGW-Downloader" -o "$OUTPUT" "$ASSET_URL" 2>/dev/null
        echo "100"
    ) | zenity --progress --title="Downloading $TAG" \
               --text="Downloading $TAG..." --pulsate --auto-close --width=400 2>/dev/null
else
    printf "Downloading %s from GitHub...\n" "$TAG"
    curl -L --progress-bar -H "User-Agent: UGW-Downloader" -o "$OUTPUT" "$ASSET_URL"
fi

if [ ! -f "$OUTPUT" ]; then
    msg_err "Download failed."
    exit 1
fi

if [ "$GUI" = "zenity" ]; then
    (
        echo "0"
        echo "# Extracting $TAG..."
        tar -xf "$OUTPUT" -C "$DEST" 2>/dev/null
        echo "100"
        echo "# Extraction complete!"
    ) | zenity --progress --title="Extracting $TAG" \
               --text="Extracting..." --pulsate --auto-close --width=400 2>/dev/null
else
    printf "Extracting %s to %s...\n" "$TAG" "$DEST"
    tar -xf "$OUTPUT" -C "$DEST"
fi

rm -f "$OUTPUT"

EXTRACTED_DIR="$(ls -d "$DEST"/GE-*/ 2>/dev/null | head -1 | sed 's|/$||')"
[ -z "$EXTRACTED_DIR" ] && EXTRACTED_DIR="$(ls -d "$DEST"/*/ 2>/dev/null | head -1 | sed 's|/$||')"
if [ -n "$EXTRACTED_DIR" ] && [ -d "$EXTRACTED_DIR/files" ]; then
    msg "Detected 'files' subfolder in $TAG — adjusting path..."
    EXTRACTED_DIR="$EXTRACTED_DIR/files"
fi
if [ -z "$EXTRACTED_DIR" ]; then
    warn "Extraction done but couldnt locate the extracted folder inside $DEST."
else
    msg "Extracted to: $EXTRACTED_DIR"
fi

if [ -f "$CONFIG" ] && [ -n "$EXTRACTED_DIR" ] && yesno "Set this runner in config.ini?"; then
    REL_PATH="$(realpath --relative-to="$DIR" "$EXTRACTED_DIR" 2>/dev/null || echo "$EXTRACTED_DIR")"
    REL_PATH="$(printf '%s\n' "$REL_PATH" | sed 's/[&/\]/\\&/g')"
    if [ "$TYPE" = "proton" ]; then
        BINARY="proton"
    else
        BINARY="wine"
    fi
    sed -i "s|^path\s*=.*|path = $REL_PATH|I" "$CONFIG"
    sed -i "s|^binary\s*=.*|binary = $BINARY|I" "$CONFIG"
    sed -i "s|^type\s*=.*|type = bundled|I" "$CONFIG"
    info "config.ini updated! Runner path set to:\n$REL_PATH"
fi

info "Done! $TAG installed."
msg "Support the project: https://ko-fi.com/watrib"
