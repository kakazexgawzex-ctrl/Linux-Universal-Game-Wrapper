#!/bin/bash

# ===================================================
# Create desktop & application launcher for the game
# ===================================================

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SCRIPT")"

CONFIG="$DIR/config.ini"
ini_get() {
    local s="$1" k="$2"
    sed -n "/^\[$s\]/,/^\[/p" "$CONFIG" | grep -i "^$k\s*=" | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'
}

GAME_NAME="$(ini_get Game name)"
[ -z "$GAME_NAME" ] && GAME_NAME="Game"

[ -z "$XDG_CONFIG_HOME" ] && XDG_CONFIG_HOME="$HOME/.config"
[ -z "$XDG_DATA_HOME" ] && XDG_DATA_HOME="$HOME/.local/share"
[ -z "$XDG_DESKTOP_DIR" ] && XDG_DESKTOP_DIR="$HOME/Desktop"

appdir="$XDG_DATA_HOME/applications"
desktop_file_app="$appdir/$GAME_NAME.desktop"
desktop_file_desk="$XDG_DESKTOP_DIR/$GAME_NAME.desktop"

# Delete on -d
if [ "$1" = "-d" ]; then
    rm -f "$desktop_file_desk" "$desktop_file_app"
    echo "Desktop files removed."
    exit 0
fi

[ ! -d "$appdir" ] && mkdir -p "$appdir"

ICON="$DIR/.icon.png"
[ -f "$ICON" ] && ICON_LINE="Icon=$ICON" || ICON_LINE=""

cat << EOM | tee "$desktop_file_app" "$desktop_file_desk" > /dev/null
[Desktop Entry]
Encoding=UTF-8
Name=$GAME_NAME
GenericName=$GAME_NAME
Exec="$DIR/start"
Terminal=false
Type=Application
Categories=Game;
StartupNotify=true
$ICON_LINE
Comment=Launch $GAME_NAME (Portable Wine Wrapper)
EOM

chmod +x "$desktop_file_app" "$desktop_file_desk"
echo "Desktop launchers created for '$GAME_NAME'."
