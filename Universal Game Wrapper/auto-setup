#!/bin/bash

# ===================================================
# Auto-Setup — Guided first-time setup
# Detects runners, detects game files, configures
# config.ini, and runs first-launch.
# ===================================================

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SCRIPT")"
CONFIG="$DIR/config.ini"
GAME_DATA="$DIR/game_data"
RUNNER_DIR="$DIR/runner"

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RESET='\033[0m'

echo "${CYAN}========================================${RESET}"
echo "${CYAN}  Universal Game Wrapper — Auto Setup${RESET}"
echo "${CYAN}========================================${RESET}"
echo

# --- Check config.ini exists ---
if [ ! -f "$CONFIG" ]; then
    echo "${RED}Error: config.ini not found!${RESET}"
    exit 1
fi

# --- Helper: read/write config ---
ini_get() {
    local s="$1" k="$2"
    sed -n "/^\[$s\]/I,/^\[/Ip" "$CONFIG" | grep -i "^$k\s*=" | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'
}
ini_set() {
    local section="$1" key="$2" value="$3"
    if grep -qi "^\[$section\]" "$CONFIG"; then
        value="$(printf '%s\n' "$value" | sed 's/[&|\]/\\&/g')"
        sed -i "/^\[$section\]/,/^\[/s|^$key\s*=.*|$key = $value|I" "$CONFIG"
    fi
}

# --- Scan for runners ---
echo "${CYAN}Scanning for Wine/Proton runners...${RESET}"
RUNNERS=()
if [ -d "$RUNNER_DIR" ]; then
    while IFS= read -r -d '' f; do
        fname="$(basename "$f")"
        case "$fname" in
            wine|wine64|wine64-preloader|proton|proton-experimental)
                RUNNERS+=("$(dirname "$f")" "$fname")
                ;;
        esac
    done < <(find "$RUNNER_DIR" -type f -executable \( -name "wine" -o -name "wine64" -o -name "proton" \) -print0 2>/dev/null)
fi

BINARY=""
R_PATH=""
if [ ${#RUNNERS[@]} -gt 0 ]; then
    echo "${GREEN}Found ${#RUNNERS[@]} runner(s):${RESET}"
    for ((i=0; i<${#RUNNERS[@]}; i+=2)); do
        rdir="${RUNNERS[$i]}"
        rbin="${RUNNERS[$((i+1))]}"
        printf "  %d) %s  (%s)\n" $((i/2+1)) "$(realpath --relative-to="$DIR" "$rdir" 2>/dev/null || echo "$rdir")" "$rbin"
    done
    echo
    read -r -p "Select runner number (or press Enter to skip): " choice
    if [ -n "$choice" ] && [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le $(( ${#RUNNERS[@]}/2 )) ]; then
        idx=$(( (choice-1)*2 ))
        R_PATH="$(realpath --relative-to="$DIR" "${RUNNERS[$idx]}" 2>/dev/null || echo "${RUNNERS[$idx]}")"
        BINARY="${RUNNERS[$((idx+1))]}"
        ini_set Runner path "$R_PATH"
        ini_set Runner binary "$BINARY"
        ini_set Runner type "bundled"
        echo "${GREEN}Runner set: $R_PATH  ($BINARY)${RESET}"
    fi
else
    echo "${YELLOW}No bundled runners found.${RESET}"
    echo "  You can use './download-runner' to download one,"
    echo "  or set [Runner] type=system in config.ini to use system Wine."
    echo
    read -r -p "Use system Wine instead? (y/N): " sys
    if [ "$sys" = "y" ] || [ "$sys" = "Y" ]; then
        ini_set Runner type "system"
        ini_set Runner path ""
        ini_set Runner binary "wine"
        echo "${GREEN}Will use system Wine.${RESET}"
    fi
fi
echo

# --- Scan for game executables ---
echo "${CYAN}Scanning for game executables...${RESET}"
EXES=()
if [ -d "$GAME_DATA" ]; then
    while IFS= read -r -d '' f; do
        EXES+=("$(basename "$f")")
    done < <(find "$GAME_DATA" -maxdepth 1 -type f \( -name "*.exe" -o -name "*.EXE" \) -print0 2>/dev/null | sort -z)
fi

CUR_EXE="$(ini_get Game exe)"
if [ ${#EXES[@]} -gt 0 ]; then
    echo "${GREEN}Found ${#EXES[@]} executable(s) in game_data/:${RESET}"
    for i in "${!EXES[@]}"; do
        printf "  %d) %s\n" $((i+1)) "${EXES[$i]}"
    done
    echo
    read -r -p "Select game executable number (or press Enter to keep '${CUR_EXE:-Game.exe}'): " choice
    if [ -n "$choice" ] && [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "${#EXES[@]}" ]; then
        ini_set Game exe "${EXES[$((choice-1))]}"
        echo "${GREEN}Game executable set to: ${EXES[$((choice-1))]}${RESET}"
        # Auto-generate game name from exe name
        GNAME="$(basename "${EXES[$((choice-1))]}" .exe)"
        ini_set Game name "$GNAME"
        echo "${GREEN}Game name set to: $GNAME${RESET}"
    fi
else
    echo "${YELLOW}No .exe files found in game_data/.${RESET}"
    echo "  Place your game files in the 'game_data' folder first."
    echo
    read -r -p "Enter the executable filename (e.g. Game.exe) [${CUR_EXE:-Game.exe}]: " exe
    [ -z "$exe" ] && exe="${CUR_EXE:-Game.exe}"
    ini_set Game exe "$exe"
    # Try to extract game name
    GNAME="$(basename "$exe" .exe)"
    [ -n "$GNAME" ] && ini_set Game name "$GNAME"
    echo "${GREEN}Game executable set to: $exe${RESET}"
fi
echo

# --- Game name ---
CUR_NAME="$(ini_get Game name)"
read -r -p "Game name [${CUR_NAME:-Game}]: " name
[ -n "$name" ] && ini_set Game name "$name"
echo

# --- Window mode ---
CUR_WND="$(ini_get Display windowed)"
read -r -p "Windowed mode? (yes/no) [${CUR_WND:-no}]: " wnd
[ -n "$wnd" ] && ini_set Display windowed "$wnd"

# --- Dependencies ---
CUR_DEPS="$(ini_get Dependencies verbs)"
read -r -p "Extra DLLs to install (space-separated, e.g. vcrun2022 d3dx9) [${CUR_DEPS:-vcrun2022}]: " deps
[ -n "$deps" ] && ini_set Dependencies verbs "$deps"
echo

# --- Summary ---
echo "${CYAN}========================================${RESET}"
echo "${CYAN}  Configuration Summary${RESET}"
echo "${CYAN}========================================${RESET}"
echo "  Game name:      $(ini_get Game name)"
echo "  Executable:     $(ini_get Game exe)"
echo "  Runner type:    $(ini_get Runner type)"
echo "  Runner path:    $(ini_get Runner path)"
echo "  Runner binary:  $(ini_get Runner binary)"
echo "  Resolution:     $(ini_get Display resolution)"
echo "  Windowed:       $(ini_get Display windowed)"
echo "  Dependencies:   $(ini_get Dependencies verbs)"
echo

# --- Run first-launch ---
read -r -p "Run first-launch now? (sets up Wine prefix, installs DLLs) (Y/n): " run_fl
if [ "$run_fl" != "n" ] && [ "$run_fl" != "N" ]; then
    echo
    echo "${CYAN}Running first-launch...${RESET}"
    "$DIR/first-launch"
    echo
    echo "${GREEN}Setup complete! Run ./start to play.${RESET}"
else
    echo
    echo "${GREEN}Configuration saved! When ready, run:${RESET}"
    echo "  ./first-launch   (one-time setup)"
    echo "  ./start          (play the game)"
fi
echo
echo "${GREEN}Support the project: https://ko-fi.com/watrib${RESET}"
