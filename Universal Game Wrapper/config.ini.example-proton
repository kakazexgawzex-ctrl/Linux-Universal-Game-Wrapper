# ============================================
# EXAMPLE: Proton-GE (proton-ge-custom)
# ============================================
# After extracting Proton-GE into runner/,
# the path is usually:  runner/GE-Proton9-25/files
# because Proton-GE has a 'files' subfolder.
#
# The binary is "proton", not "wine".
#
# ============================================

[Game]
name = GAME_NAME_HERE
exe = Game.exe
version = 1.0

[Runner]
type = bundled
path = runner/GE-Proton9-25/files
binary = proton

[Display]
resolution = auto
windowed = no
fix_resolution = no

[Dependencies]
verbs = vcrun2022

[Performance]
esync = yes
fsync = no
gamemode = auto
