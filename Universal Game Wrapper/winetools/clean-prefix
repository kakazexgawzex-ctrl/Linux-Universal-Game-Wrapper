#!/bin/bash
echo "This will DELETE the Wine prefix ($WINEPREFIX) — all game settings lost!"
read -r -p "Are you sure? (yes/no): " answer
[ "$answer" != "yes" ] && exit 0

DIR="$(dirname "$(realpath "$0")")/.."
export WINEPREFIX="$DIR/prefix"

rm -rf "$WINEPREFIX/dosdevices" \
       "$WINEPREFIX/system.reg" \
       "$WINEPREFIX/user.reg" \
       "$WINEPREFIX/userdef.reg" \
       "$WINEPREFIX/.update-timestamp" \
       "$WINEPREFIX/drive_c/ProgramData" \
       "$WINEPREFIX/drive_c/Program Files" \
       "$WINEPREFIX/drive_c/Program Files (x86)" \
       "$WINEPREFIX/drive_c/users" \
       "$WINEPREFIX/drive_c/windows" \
       "$WINEPREFIX/drive_c/.windows-serial"

rm -rf "$DIR/home"

echo "Prefix cleaned. Run ./first-launch to recreate it."
