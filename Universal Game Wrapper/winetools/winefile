#!/bin/bash
DIR="$(dirname "$(realpath "$0")")/.."
export HOME="$DIR/home"
export WINEPREFIX="$DIR/prefix"
export WINEDEBUG="-all"

CONFIG="$DIR/config.ini"
ini_get() {
    local s="$1" k="$2"
    sed -n "/^\[$s\]/I,/^\[/Ip" "$CONFIG" | grep -i "^$k\s*=" | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'
}
RPATH="$(ini_get Runner path)"
RBIN="$(ini_get Runner binary)"
[ -z "$RPATH" ] && RPATH="runner"
[ -z "$RBIN" ] && RBIN="wine"

WINE="$DIR/$RPATH/$RBIN"
[ ! -f "$WINE" ] && WINE="$(command -v "$RBIN")"
[ -z "$WINE" ] && { echo "Wine not found."; exit 1; }

if echo "$RBIN" | grep -qi proton; then
    "$WINE" run winefile
else
    "$WINE" winefile
fi
