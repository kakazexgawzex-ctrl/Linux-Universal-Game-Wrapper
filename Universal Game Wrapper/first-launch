#!/bin/bash

# ===================================================
# First-Launch Setup — Initializes Wine prefix and
# installs dependencies (winetricks verbs from config)
# ===================================================

GREEN='\033[1;32m'; CYAN='\033[1;36m'; YELLOW='\033[1;33m'; RED='\033[1;31m'; RESET='\033[0m'

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SCRIPT")"
cd "$DIR" || exit 1

CONFIG="$DIR/config.ini"
if [ ! -f "$CONFIG" ]; then
    printf "${RED}Error: config.ini not found!${RESET}\n"
    printf "Run ${CYAN}./auto-setup${RESET} or ${CYAN}./configure${RESET} to create one.\n"
    exit 1
fi

ini_get() {
    local s="$1" k="$2"
    sed -n "/^\[$s\]/I,/^\[.*\]/Ip" "$CONFIG" 2>/dev/null | grep -i "^$k\s*=" | head -1 | cut -d= -f2- | sed 's/^ *//;s/ *$//'
}

GAME_NAME="$(ini_get Game name)"
VERBS="$(ini_get Dependencies verbs)"
RUNNER_TYPE="$(ini_get Runner type)"
RUNNER_PATH="$(ini_get Runner path)"
RUNNER_BINARY="$(ini_get Runner binary)"

[ -z "$GAME_NAME" ] && GAME_NAME="Game"
[ -z "$RUNNER_TYPE" ] && RUNNER_TYPE="bundled"
[ -z "$RUNNER_PATH" ] && RUNNER_PATH="runner"
[ -z "$RUNNER_BINARY" ] && RUNNER_BINARY="wine"

export HOME="$DIR/home"
export WINEPREFIX="$DIR/prefix"

printf "${CYAN}========================================${RESET}\n"
printf "${CYAN}  First-Launch Setup: %s${RESET}\n" "$GAME_NAME"
printf "${CYAN}========================================${RESET}\n"
printf "\n"

if [ "$RUNNER_TYPE" = "system" ]; then
    WINE="$(command -v "$RUNNER_BINARY")"
    if [ -z "$WINE" ]; then
        printf "${RED}Error: %s not found in PATH${RESET}\n" "$RUNNER_BINARY"
        printf "Install Wine or run ${CYAN}./download-runner${RESET} to get a bundled runner.\n"
        exit 1
    fi
    WINETRICKS="$(command -v winetricks)"
    if [ -z "$WINETRICKS" ]; then
        printf "${RED}Error: winetricks not found in PATH${RESET}\n"
        printf "Install winetricks or use a bundled runner (./download-runner).\n"
        exit 1
    fi
else
    WINE="$DIR/$RUNNER_PATH/$RUNNER_BINARY"
    if echo "$RUNNER_BINARY" | grep -qi proton && [ -f "$DIR/$RUNNER_PATH/files/bin/wine" ]; then
        WINE="$DIR/$RUNNER_PATH/files/bin/wine"
    fi
    if [ ! -f "$WINE" ]; then
        printf "${RED}Error: Runner not found at %s${RESET}\n" "$WINE"
        printf "Download one with ${CYAN}./download-runner${RESET},\n"
        printf "or extract one into the 'runner' folder,\n"
        printf "or set ${CYAN}[Runner] type=system${RESET} in config.ini.\n"
        exit 1
    fi
    WINETRICKS="$DIR/winetools/winetricks"
    if [ ! -f "$WINETRICKS" ]; then
        printf "${YELLOW}Downloading winetricks...${RESET}\n"
        mkdir -p "$DIR/winetools"
        curl -sL "https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks" -o "$WINETRICKS" || {
            printf "${RED}Failed to download winetricks. Check internet connection.${RESET}\n"
            exit 1
        }
        chmod +x "$WINETRICKS"
        printf "${GREEN}Winetricks downloaded.${RESET}\n"
    fi
fi

if [ ! -d "$WINEPREFIX/drive_c" ]; then
    printf "  ${YELLOW}►${RESET} Creating Wine prefix...\n"
    WINEDEBUG="-all" "$WINE" wineboot -u 2>/dev/null || true
    printf "  ${GREEN}✔ Prefix created.${RESET}\n"
else
    printf "  ${GREEN}✔ Wine prefix already exists.${RESET}\n"
fi

if [ -n "$VERBS" ]; then
    printf "  ${YELLOW}►${RESET} Installing dependencies: ${CYAN}%s${RESET} (this may take a while)...\n" "$VERBS"
    export WINE="$WINE"
    # shellcheck disable=SC2086
    WINEDLLOVERRIDES="mscoree,mshtml=" WINEDEBUG="-all" "$WINETRICKS" -q $VERBS
    printf "  ${GREEN}✔ Dependencies installed.${RESET}\n"
fi

printf "\n"
printf "${GREEN}========================================${RESET}\n"
printf "${GREEN}  Setup complete! Run ./start to play.${RESET}\n"
printf "${GREEN}========================================${RESET}\n"
printf "Support the project: https://ko-fi.com/watrib\n"
